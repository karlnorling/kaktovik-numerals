{
  "name": "@kaktovik-numerals/cli",
  "version": "0.0.0",
  "description": "Draw Kaktovik numerals from the command line: SVG, PNG, JPEG or WebP",
  "keywords": [
    "alaska",
    "base-20",
    "cli",
    "inupiaq",
    "kaktovik",
    "kaktovik-numerals",
    "number",
    "numerals",
    "png",
    "svg",
    "vigesimal"
  ],
  "homepage": "https://karlnorling.github.io/kaktovik-numerals/",
  "bugs": {
    "url": "https://github.com/karlnorling/kaktovik-numerals/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karlnorling/kaktovik-numerals.git",
    "directory": "packages/@kaktovik-numerals/cli"
  },
  "bin": {
    "kaktovik": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "yarn build"
  },
  "dependencies": {
    "@kaktovik-numerals/core": "workspace:^",
    "@kaktovik-numerals/raster": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">= 20.0.0"
  }
}
